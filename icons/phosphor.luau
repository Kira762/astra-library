local function expand(prefix: string, pack: string, raw: { [string]: string }): { [string]: string }
    local t = {}
    for k, name in raw do
        local first = string.lower(string.sub(name, 1, 1))
        t[k] = prefix .. first .. "/" .. pack .. name .. ".png"
    end
    return t
end

